# ============================================================
# environments/production.env
# Purpose: Non-secret runtime environment variables for the
#          production App Runner service.
# Usage: These values are set as GitHub Actions Variables
#        (Settings → Environments → production → Variables).
#        DO NOT store secrets here — use GitHub Secrets instead.
# Side effect: Changes here affect production App Runner runtime
#              configuration on next deployment.
# ============================================================

# ---- AWS Infrastructure ----
AWS_REGION=ap-southeast-1
ECR_REPOSITORY=my-app
APP_RUNNER_SERVICE_ARN_PROD=arn:aws:apprunner:ap-southeast-1:123456789012:service/my-app-prod/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Application Runtime ----
APP_ENV=production
SERVER_PORT=8080
LOG_LEVEL=WARN
LOG_FORMAT=json

# ---- SonarCloud ----
SONAR_PROJECT_KEY=my-org_my-app
SONAR_ORGANIZATION=my-org

# ---- App Runner Service URL ----
PRODUCTION_URL=https://xxxxxxxx.ap-southeast-1.awsapprunner.com
