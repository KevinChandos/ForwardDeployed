# ============================================================
# environments/staging.env
# Purpose: Non-secret runtime environment variables for the
#          staging App Runner service.
# Usage: Set as GitHub Actions Variables under the "staging"
#        environment. DO NOT store secrets here.
# Side effect: Changes here affect staging App Runner runtime
#              configuration on next deployment to develop.
# ============================================================

# ---- AWS Infrastructure ----
AWS_REGION=ap-southeast-1
ECR_REPOSITORY=my-app
APP_RUNNER_SERVICE_ARN_STAGING=arn:aws:apprunner:ap-southeast-1:123456789012:service/my-app-staging/yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ---- Application Runtime ----
APP_ENV=staging
SERVER_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- SonarCloud ----
SONAR_PROJECT_KEY=my-org_my-app
SONAR_ORGANIZATION=my-org

# ---- App Runner Service URL ----
STAGING_URL=https://yyyyyyyy.ap-southeast-1.awsapprunner.com
