# ============================================================
# environments/feature.env
# Purpose: Non-secret variables shared by all feature/* branch
#          CI runs. No deployment occurs on feature branches.
# Usage: Set as GitHub Actions repository-level Variables
#        (Settings → Secrets and variables → Actions → Variables).
# ============================================================

# ---- Application Build ----
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ---- SonarCloud ----
SONAR_PROJECT_KEY=my-org_my-app
SONAR_ORGANIZATION=my-org
