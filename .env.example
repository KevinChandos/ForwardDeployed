# =============================================================================
# .env.example — Bookworm API environment variable reference
#
# HOW TO USE:
#   cp .env.example .env
#   # Edit .env and fill in every value marked REQUIRED
#   # Never commit .env to version control — it contains secrets
#
# WHY this file exists:
#   docker-compose.yml reads all runtime config from environment variables
#   so that the same image runs identically in local, staging, and production
#   without baking credentials into the image or the compose file.
# =============================================================================

# =============================================================================
# PostgreSQL
# =============================================================================

# Database name — must match the value used when the DB was initialised.
POSTGRES_DB=bookworm

# Application DB user — also used by Flyway migrations.
# In production this should be a least-privilege role (no CREATEDB / SUPERUSER).
POSTGRES_USER=bookworm

# REQUIRED — set a strong password. Minimum 20 characters recommended.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Host port that the postgres container binds on localhost (default 5432).
# Change if 5432 is already in use on your machine.
POSTGRES_PORT=5432

# =============================================================================
# Flyway
# =============================================================================
# Flyway reads POSTGRES_* directly (configured in docker-compose.yml command).
# No additional Flyway-specific variables are needed unless you need to change
# the migration baseline or schema history table name.

# =============================================================================
# JWT
# =============================================================================

# REQUIRED — HMAC-SHA-256 signing secret. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_AT_MINIMUM

# Access token TTL in seconds (default 900 = 15 minutes).
JWT_ACCESS_TTL=900

# Refresh token TTL in seconds (default 604800 = 7 days).
JWT_REFRESH_TTL=604800

# =============================================================================
# API server
# =============================================================================

# Host port the Spring Boot container exposes externally (default 8080).
API_PORT=8080

# Maximum JVM heap as a percentage of the cgroup memory limit (see Dockerfile).
# Should stay below 80% to leave headroom for Metaspace and thread stacks.
# (Configured via JAVA_OPTS inside docker-compose.yml — not directly here.)

# Container memory limit (Docker resource constraint).
# Increase for production; decrease for resource-constrained environments.
API_MEM_LIMIT=512m

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins for CORS preflight.
# Example for a React frontend served from localhost:
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Logging
# =============================================================================

# Root log level for io.bookworm.* packages. Values: TRACE DEBUG INFO WARN ERROR
LOG_LEVEL=INFO

# =============================================================================
# Docker image tagging (used by docker-compose.yml build target)
# =============================================================================

# Version tag applied to the built bookworm-api image.
# In CI/CD this should be set to the Git commit SHA or semantic version.
APP_VERSION=latest

# =============================================================================
# Database connection pool (HikariCP)
# =============================================================================

# Maximum number of connections in the pool.
# Rule of thumb: (2 × vCPU) + effective_spindle_count.
DB_POOL_SIZE=10

# Minimum number of idle connections kept alive.
DB_POOL_MIN_IDLE=2
